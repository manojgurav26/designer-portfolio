rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Site settings - readable by public, writable by admin only
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Designs - public read, admin create/update/delete
    match /designs/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Enquiries - allow unauthenticated users to create (contact form),
    // but only admin can read/update/delete enquiries
    match /enquiries/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}