rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }

    // Public assets (examples) - readable by anyone, writable by admin
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings logos - public read, admin write
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Designs images - public read, admin write
    match /designs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}